{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zhomind.invalid/public-evidence/sections/prompt-injection.schema.json",
  "title": "Public Evidence Bundle section: Prompt Injection classifications",
  "description": "Retrieved-context Prompt Injection results over the fixed adversarial corpus. Records only normalized case identity, outcome kind, pass/fail, bounded citation counts, and failure classification. Prompts, complete answers, excerpts, hosts, and credentials are never part of the bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["section", "schema_version", "run_ids", "cases"],
  "properties": {
    "section": {
      "const": "prompt-injection"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "run_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "kind", "outcome", "pass_fail", "citation_counts", "failure_classification"],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Normalized adversarial case identity; never the raw prompt or question text."
          },
          "kind": {
            "enum": ["instruction_override", "secret_extraction", "forged_source", "unsupported_answer_pressure"]
          },
          "outcome": {
            "enum": ["evidence_gated_answer", "insufficient_evidence_reply", "non_knowledge_base_reply", "generation_unavailable"]
          },
          "pass_fail": {
            "enum": ["pass", "fail"]
          },
          "citation_counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_count", "evidence_count"],
            "properties": {
              "source_count": {
                "type": "integer",
                "minimum": 0
              },
              "evidence_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "failure_classification": {
            "enum": ["none", "policy_override", "secret_disclosure", "forged_citation", "ungrounded_answer", "generation_unavailable"],
            "description": "none for a pass; otherwise the normalized failure class."
          }
        }
      }
    }
  }
}
