# This file is safe to commit. Copy it to ../../.env, which is ignored by Git.
# Values are parsed literally; do not wrap values in shell command substitutions.

# SSH target. Pin the expected host-key fingerprint before the first publish.
DEPLOY_HOST=45.207.207.65
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=
DEPLOY_SSH_IDENTITY_FILE=
DEPLOY_SSH_HOST_KEY_SHA256=
DEPLOY_APP_DIR=/opt/zhomind-v2
DEPLOY_GIT_REF=refs/heads/experiment/retrieval-evidence
DEPLOY_COMPOSE_PROJECT=zhomind
DEPLOY_CONFIGURE_UFW=true

# A DNS name whose A record points to DEPLOY_HOST. Caddy obtains HTTPS certificates.
DEPLOY_CADDY_SITE_ADDRESS=

# Required application and persistence secrets. Generate unique high-entropy values.
# POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD must use only letters, digits, _ and -.
JWT_SECRET=
ADMIN_INVITE_CODE=
SYSTEM_SETTINGS_DRAFT_ENABLED=true
SYSTEM_SETTINGS_APPLICATION_ENABLED=true
SYSTEM_SETTINGS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=zhomindminio
MINIO_ROOT_PASSWORD=

# Primary LLM provider.
ARK_API_KEY=
BASE_URL=
MODEL=doubao-seed-2-0-pro-260215
GRADE_MODEL=doubao-seed-2-0-lite-260215
FAST_MODEL=doubao-seed-1-6-flash-250828

# Live embedding is required for document build and Retrieval Smoke acceptance.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
DENSE_EMBEDDING_DIM=1024

# Optional rerank and fallback providers.
RERANK_MODEL=jina-reranker-v3
RERANK_BINDING_HOST=
RERANK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Existing runtime defaults.
RAG_GRAPH_ALIAS=default_v1
RAG_ENABLE_TOOLS=false
RAG_TOOL_MAX_CALLS=3
RAG_TOOL_MAX_PARALLEL=2
RAG_TOOL_TIMEOUT_MS=8000
RAG_DEFAULT_LLM_PROVIDER=chat-default-llm
RAG_PRIMARY_LLM_PROVIDER=ark
RAG_LLM_FALLBACK_PROVIDERS=openai,anthropic
RAG_DISABLE_GATE=true
DOCUMENT_ALLOWED_EXTENSIONS=txt,md,pdf
DOC_WORKER_ENABLED=true
DOC_WORKER_MAX_CONCURRENCY=1
