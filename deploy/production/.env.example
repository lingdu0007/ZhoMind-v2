# Application runtime configuration. Keep the filled file only on the server
# at /opt/zhomind-v2/.env. Values are parsed literally; do not use shell expressions.

# Required application and persistence secrets. Generate unique high-entropy values.
# POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD must use only letters, digits, _ and -.
JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
SYSTEM_SETTINGS_DRAFT_ENABLED=true
SYSTEM_SETTINGS_APPLICATION_ENABLED=true
SYSTEM_SETTINGS_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=zhomindminio
MINIO_ROOT_PASSWORD=

# Primary LLM provider.
ARK_API_KEY=
BASE_URL=
MODEL=doubao-seed-2-0-pro-260215
GRADE_MODEL=doubao-seed-2-0-lite-260215
FAST_MODEL=doubao-seed-1-6-flash-250828

# Live embedding is required for document build and Retrieval Smoke acceptance.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
DENSE_EMBEDDING_DIM=1024

# Protected ClaimResolver profile. Leave all three empty until the independent
# human-reviewed calibration set passes its gate and the runtime profile hash is
# recorded. The host file must be root-owned mode 0600; the container path is fixed.
CLAIM_RESOLVER_PROFILE_HOST_PATH=
CLAIM_RESOLVER_PROFILE_SHA256=

# Reserved for the later SiliconFlow reranker integration; unused by the current runtime.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Existing runtime defaults.
RAG_GRAPH_ALIAS=default_v1
RAG_ENABLE_TOOLS=false
RAG_TOOL_MAX_CALLS=3
RAG_TOOL_MAX_PARALLEL=2
RAG_TOOL_TIMEOUT_MS=8000
RAG_DEFAULT_LLM_PROVIDER=chat-default-llm
RAG_PRIMARY_LLM_PROVIDER=ark
RUNTIME_ANSWER_EVIDENCE_MAX_ITEMS=3
RUNTIME_ANSWER_EVIDENCE_MAX_CHARS_PER_SOURCE=160
DOCUMENT_ALLOWED_EXTENSIONS=txt,md,pdf
DOC_WORKER_ENABLED=true
DOC_WORKER_MAX_CONCURRENCY=1
