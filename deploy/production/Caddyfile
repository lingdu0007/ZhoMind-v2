{$DEPLOY_CADDY_SITE_ADDRESS} {
    # API responses stay uncompressed so Server-Sent Events (chat stage
    # progress) are flushed to the client immediately instead of being
    # buffered by the zstd/gzip encoder.
    @api path_regexp api ^/api/(.*)$
    @not_api not path /api/*

    encode @not_api zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle @api {
        rewrite @api /api/v1/{re.api.1}
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
